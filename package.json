{
  "name": "cuahsi-site",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "build:search": "nuxt generate && pagefind --site .output/public",
    "preview:search": "npm run build:search && npx serve .output/public",
    "validate:content": "node scripts/validate-content.mjs",
    "lint": "eslint .",
    "visual:compare": "playwright test",
    "visual:baseline": "playwright test --update-snapshots=all"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.13",
    "@typescript-eslint/parser": "8.71.0",
    "cheerio": "1.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "nuxt": "^3.12.0",
    "pagefind": "^1.1.0",
    "typescript": "6.0.3",
    "vue-eslint-parser": "10.4.1",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "dependencies": {
    "@nuxt/content": "^2.13.0",
    "@nuxtjs/robots": "^4.1.0",
    "@nuxtjs/sitemap": "^5.3.0"
  },
  "type": "module"
}
